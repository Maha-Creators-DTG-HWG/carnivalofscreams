# Midtrans Snap
# Copy to .env and fill from Midtrans Dashboard → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXX
MIDTRANS_IS_PRODUCTION=false

# DOKU message-as-a-service, used only for WhatsApp confirmations
DOKU_CLIENT_ID=BRN-XXXX-XXXXXXXXXXXXX
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=false
DOKU_WHATSAPP_TEMPLATE_ID=

# Supabase. The publishable key is safe in the browser; the secret key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
