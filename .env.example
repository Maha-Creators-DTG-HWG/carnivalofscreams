# Midtrans Snap
# Copy to .env and fill from Midtrans Dashboard → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXX
MIDTRANS_IS_PRODUCTION=false

# Fonnte, sends the invoice PDF on WhatsApp after payment. Needs a Fonnte plan
# that can send files. Leave empty to turn WhatsApp off.
FONNTE_TOKEN=

# Supabase. The publishable key is safe in the browser; the secret key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public site origin for metadata and fallback callback URLs
NEXT_PUBLIC_SITE_URL=https://www.carnavalofscreams.com

# Resend invoice emails. Use a sender on a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Carnaval of Screams <noreply@carnavalofscreams.com>"
